{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "verxhade:pvp_bot",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/steve"
      },
      "geometry": {
        "default": "geometry.humanoid"
      },
      "scripts": {
        "scale": "0.9375",
        "pre_animation": [
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed) * 57.3;"
        ],
        "animate": [
          "humanoid_base_pose",
          "look_at_target",
          "move",
          { "attack": "variable.attack_time > 0.0" },
          "bob"
        ]
      },
      "animations": {
        "humanoid_base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "move": "animation.humanoid.move",
        "attack": "animation.humanoid.attack.rotations",
        "bob": "animation.humanoid.bob"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "enable_attachables": true
    }
  }
}