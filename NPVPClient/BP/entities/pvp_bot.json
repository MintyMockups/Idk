    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["bot:medium"]
        }
      },
      "vh:apply_enchanted": {
        "add": { "component_groups": ["bot:enchanted_gear"] },
        "remove": { "component_groups": ["bot:plain_gear"] }
      },
      "vh:apply_plain": {
        "add": { "component_groups": ["bot:plain_gear"] },
        "remove": { "component_groups": ["bot:enchanted_gear"] }
      },
      "set_easy": {
        "add": { "component_groups": ["bot:easy"] },
        "remove": { "component_groups": ["bot:medium", "bot:hard", "bot:harder", "bot:dummy"] }
      },
      "set_medium": {
        "add": { "component_groups": ["bot:medium"] },
        "remove": { "component_groups": ["bot:easy", "bot:hard", "bot:harder", "bot:dummy"] }
      },
      "set_hard": {
        "add": { "component_groups": ["bot:hard"] },
        "remove": { "component_groups": ["bot:easy", "bot:medium", "bot:harder", "bot:dummy"] }
      },
      "set_harder": {
        "add": { "component_groups": ["bot:harder"] },
        "remove": { "component_groups": ["bot:easy", "bot:medium", "bot:hard", "bot:dummy"] }
      },
      "set_dummy": {
        "add": { "component_groups": ["bot:dummy"] },
        "remove": { "component_groups": ["bot:easy", "bot:medium", "bot:hard", "bot:harder"] }
